PORT=4000
NODE_ENV=development

API_DOMAIN=app.example.com

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/citizenpulse?retryWrites=true&w=majority

# Option B: self-hosted Mongo via `docker compose up` (see README > Docker deployment).
# docker-compose.yml builds MONGO_URI itself from these two values and
# overrides whatever's set above - only fill these in for the Docker path.
MONGO_ROOT_USERNAME=citizenpulse
MONGO_ROOT_PASSWORD=replace_this_with_a_long_random_password

# Secret used to sign anonymous session JWTs
JWT_SECRET=replace_this_with_a_long_random_string
ADMIN_JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=365d

# CORS - comma separated list of allowed origins
CLIENT_ORIGINS=http://localhost:19006,https://app.citizenpulse.ke

# How often the scheduler container re-runs mood aggregation (cron syntax)
AGGREGATION_CRON=0 * * * *

# Secret used to sign anonymous session JWTs
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=365d

# CORS - comma separated list of allowed origins
CLIENT_ORIGINS=http://localhost:19006,https://app.citizenpulse.ke
